# Kreeda Ankana Hyperledger Fabric API Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Fabric Network Configuration
CHANNEL_NAME=booking-channel
CHAINCODE_NAME=kreeda-ankana
NETWORK_ID=kubernetes-prod-network

# Connection Profile Path
CONNECTION_PROFILE=./connection.json
WALLET_PATH=./wallet

# Identity (must match one in wallet)
IDENTITY=app-user

# Admin Identity (for enrollment)
ADMIN_ID=admin
ADMIN_SECRET=adminpw

# TLS Configuration (set to true for production with TLS)
TLS_ENABLED=false
TLS_CERT_PATH=./tls/ca.crt

# CouchDB Configuration (for world state)
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=admin

# Logging
LOG_LEVEL=info